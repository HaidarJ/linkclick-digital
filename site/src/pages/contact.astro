---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import WaIcon from '../components/WaIcon.astro';
import { graph, webPage, breadcrumbs } from '../lib/schema';
import { FORM_ENDPOINT, BUDGET_BANDS, WHATSAPP } from '../lib/site';

const path = '/contact/';
const crumbs = [{ label: 'Contact' }];
const title = 'Book a Strategy Call | Linkclick Digital';
const description = 'Send Linkclick Digital an enquiry and we will be in touch within 24 hours to arrange a 30-minute strategy call. Or message us on WhatsApp.';
const schema = graph(webPage(path, 'ContactPage', title, description), breadcrumbs(path, crumbs));
---
<Base title={title} description={description} schema={schema}>
  <PageHero
    h1="Book a strategy call"
    lede="Send an enquiry and someone from Linkclick Digital will be in touch within 24 hours to arrange a 30-minute strategy call. Tell us what you sell, who you sell to and what isn't working yet."
    breadcrumb={crumbs}
    cta={false}
  />
  <div class="wrap contact-grid">
    <form class="enquiry" method="post" action={FORM_ENDPOINT || undefined} data-endpoint={FORM_ENDPOINT} aria-labelledby="form-h" novalidate>
      <h2 id="form-h">Send an enquiry</h2>
      <div class="field">
        <label for="f-name">Your name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="f-email">Work email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="f-phone">Phone <span class="opt">(optional)</span></label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel">
      </div>
      <div class="field-pair">
        <div class="field">
          <label for="f-business">Business name</label>
          <input id="f-business" name="business" type="text" autocomplete="organization">
        </div>
        <div class="field">
          <label for="f-website">Website <span class="opt">(optional)</span></label>
          <input id="f-website" name="website" type="url" inputmode="url" placeholder="https://">
        </div>
      </div>
      <div class="field">
        <label for="f-industry">Your industry</label>
        <input id="f-industry" name="industry" type="text" autocomplete="off" placeholder="What you sell, in a few words">
      </div>
      {BUDGET_BANDS.length > 0 && (
        <div class="field">
          <label for="f-budget">Monthly budget</label>
          <select id="f-budget" name="budget">
            <option value="">Choose a range</option>
            {BUDGET_BANDS.map((b) => <option>{b}</option>)}
          </select>
        </div>
      )}
      <div class="field">
        <label for="f-message">What would you like help with?</label>
        <textarea id="f-message" name="message" rows="5" required></textarea>
      </div>
      <div class="field hp" aria-hidden="true">
        <label for="f-fax">Leave this empty</label>
        <input id="f-fax" name="fax" type="text" tabindex="-1" autocomplete="off">
      </div>
      <input type="hidden" name="t" value="">
      <div class="field field-check">
        <input id="f-consent" name="consent" type="checkbox" value="yes" required>
        <label for="f-consent">I agree that Linkclick Digital can keep these details to reply to my enquiry, as set out in the <a href="/privacy/">privacy policy</a>.</label>
      </div>
      <button class="btn btn-primary enquiry-send" type="submit"><span class="send-spin" aria-hidden="true"></span><span class="send-label">Send enquiry</span></button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
    <div class="contact-routes">
      <section class="contact-route" aria-labelledby="wa-h">
        <h2 id="wa-h">Message us</h2>
        <p>Prefer to type? Send a WhatsApp message and a person replies.</p>
        <a class="btn btn-outline" href={WHATSAPP} target="_blank" rel="noopener"><WaIcon /><span>Chat on WhatsApp</span></a>
      </section>
      <p class="contact-place">Linkclick Digital · Based in London, working worldwide</p>
    </div>

  </div>
</Base>

<script>
  // Progressive enhancement: validate, post to the Apps Script endpoint while the button shows a sending
  // state, then go to the thank-you page. Without JavaScript the form posts straight to Apps Script.
  const THANKS = '/contact/thank-you/';
  const TIMEOUT_MS = 30000;
  const form = document.querySelector<HTMLFormElement>('form.enquiry');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('.enquiry-send')!;
    const label = button.querySelector<HTMLElement>('.send-label')!;
    const elapsed = form.elements.namedItem('t') as HTMLInputElement;
    const started = Date.now();

    const sending = (on: boolean) => {
      form.classList.toggle('is-sending', on);
      form.setAttribute('aria-busy', String(on));
      button.disabled = on;
      label.textContent = on ? 'Sending…' : 'Send enquiry';
    };

    // Coming back to this page from the thank-you page (back button) must show a usable form.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) { sending(false); status.textContent = ''; }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.classList.contains('is-sending')) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        status.textContent = "The form isn't connected yet. Please message us on WhatsApp.";
        return;
      }
      // Time on the page, measured here so a fast or slow device clock can't trip the spam check.
      elapsed.value = String(Date.now() - started);
      const body = new FormData(form);
      sending(true);
      status.textContent = 'Sending your enquiry. This can take a few seconds.';
      const timer = new AbortController();
      const stop = window.setTimeout(() => timer.abort(), TIMEOUT_MS);
      try {
        // Apps Script web apps don't return CORS headers, so the response can't be read: a network
        // error or the timeout is the only failure the page can see.
        await fetch(endpoint, { method: 'POST', mode: 'no-cors', body, signal: timer.signal });
        form.reset();
        window.location.assign(THANKS);
      } catch {
        sending(false);
        status.textContent = "Sorry, that didn't send. Please try again or message us on WhatsApp.";
      } finally {
        window.clearTimeout(stop);
      }
    });
  }
</script>
