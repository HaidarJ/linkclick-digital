---
// Cookie consent, built to UK rules (PECR and the ICO's guidance on cookies):
// - nothing optional is set before a visitor opts in; no pre-ticked boxes;
// - the banner offers "Accept all" and "Manage cookie consent" in the same style (owner's choice,
//   2026-11-10); "Reject all" is in the settings panel. Note: the ICO expects refusing to be as easy as
//   accepting, so a "Reject all" button on the banner is the safer option while Google Analytics is in use;
// - choices are per category and can be changed at any time from "Cookie settings" in the footer;
// - the choice itself is kept in one strictly necessary first-party cookie (no consent needed for that).
// Without JavaScript nothing optional can load, so the banner simply isn't shown.
import { GA_MEASUREMENT_ID, CONSENT } from '../lib/site';
---
<section class="cc" data-cc hidden aria-labelledby="cc-title" data-ga={GA_MEASUREMENT_ID} data-cookie={CONSENT.cookie} data-version={CONSENT.version} data-days={CONSENT.days}>
  <div class="cc-card on-dark">
    <h2 class="cc-title" id="cc-title">Cookies</h2>
    <p class="cc-text">We use cookies to remember your choice and, with your permission, to see how the site is used. <a href="/cookies/">Cookie policy</a></p>
    <div class="cc-actions">
      <button type="button" class="btn btn-light cc-btn" data-cc-accept>Accept all</button>
      <button type="button" class="btn btn-light cc-btn" data-cc-manage>Manage cookie consent</button>
    </div>
  </div>
</section>

<dialog class="cc-dialog" data-cc-dialog aria-labelledby="ccd-title">
  <form method="dialog" class="cc-panel">
    <div class="cc-panel-head">
      <h2 class="cc-panel-title" id="ccd-title">Cookie settings</h2>
      <button type="submit" class="cc-close" value="close" aria-label="Close cookie settings">Close</button>
    </div>
    <p class="cc-panel-intro">Choose which cookies Linkclick Digital can use on this site. You can change your mind at any time from "Cookie settings" at the bottom of every page. The <a href="/cookies/">cookie policy</a> lists each cookie.</p>
    <ul class="cc-cats">
      <li class="cc-cat">
        <div class="cc-cat-head"><h3>Strictly necessary</h3><span class="cc-always">Always on</span></div>
        <p>Remember your cookie choices and keep the site working. These don't need consent and can't be turned off here.</p>
      </li>
      <li class="cc-cat">
        <div class="cc-cat-head">
          <h3 id="cc-analytics-h">Analytics</h3>
          <input class="cc-switch" type="checkbox" role="switch" name="analytics" aria-labelledby="cc-analytics-h" aria-describedby="cc-analytics-d">
        </div>
        <p id="cc-analytics-d">Count visits and see which pages help people, using Google Analytics. Off unless you turn it on.</p>
      </li>
      <li class="cc-cat">
        <div class="cc-cat-head">
          <h3 id="cc-marketing-h">Marketing</h3>
          <input class="cc-switch" type="checkbox" role="switch" name="marketing" aria-labelledby="cc-marketing-h" aria-describedby="cc-marketing-d">
        </div>
        <p id="cc-marketing-d">Measure whether our ads on platforms such as Google, Meta and TikTok lead to enquiries. Off unless you turn it on.</p>
      </li>
    </ul>
    <div class="cc-actions cc-actions--panel">
      <button type="button" class="btn btn-primary cc-btn" data-cc-save>Save my choices</button>
      <button type="button" class="btn btn-outline cc-btn" data-cc-accept>Accept all</button>
      <button type="button" class="btn btn-outline cc-btn" data-cc-reject>Reject all</button>
    </div>
  </form>
</dialog>

<script>
  type Consent = { v: number; analytics: boolean; marketing: boolean; t: number };
  const root = document.querySelector<HTMLElement>('[data-cc]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-cc-dialog]');

  if (root && dialog) {
    const NAME = root.dataset.cookie!;
    const VERSION = Number(root.dataset.version);
    const DAYS = Number(root.dataset.days);
    const GA = root.dataset.ga || '';

    const read = (): Consent | null => {
      const raw = document.cookie.split('; ').find((c) => c.startsWith(NAME + '='))?.slice(NAME.length + 1);
      if (!raw) return null;
      try {
        const c = JSON.parse(decodeURIComponent(raw)) as Consent;
        return c.v === VERSION ? c : null;
      } catch {
        return null;
      }
    };

    const write = (c: Omit<Consent, 'v' | 't'>) => {
      const value: Consent = { v: VERSION, t: Date.now(), ...c };
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `${NAME}=${encodeURIComponent(JSON.stringify(value))}; Max-Age=${DAYS * 86400}; Path=/; SameSite=Lax${secure}`;
      return value;
    };

    // Remove analytics cookies when consent is withdrawn (Google sets them on the site's own domain).
    const clearAnalytics = () => {
      const host = location.hostname.replace(/^www\./, '');
      document.cookie.split('; ').map((c) => c.split('=')[0]).filter((n) => n === '_ga' || n.startsWith('_ga_')).forEach((n) => {
        for (const domain of ['', `; Domain=${host}`, `; Domain=.${host}`]) document.cookie = `${n}=; Max-Age=0; Path=/${domain}`;
      });
    };

    const w = window as unknown as { dataLayer: unknown[]; gtag: (...a: unknown[]) => void; __lcGa?: boolean };
    const loadAnalytics = (c: Consent) => {
      if (!GA) return; // not set up yet: nothing to load
      if (!w.__lcGa) {
        w.__lcGa = true;
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () { w.dataLayer.push(arguments); };
        w.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
        w.gtag('js', new Date());
        w.gtag('config', GA);
        const s = document.createElement('script');
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA)}`;
        document.head.appendChild(s);
      }
      w.gtag('consent', 'update', {
        analytics_storage: c.analytics ? 'granted' : 'denied',
        ad_storage: c.marketing ? 'granted' : 'denied',
        ad_user_data: c.marketing ? 'granted' : 'denied',
        ad_personalization: c.marketing ? 'granted' : 'denied',
      });
    };

    const apply = (c: Consent) => {
      if (c.analytics || c.marketing) loadAnalytics(c);
      else if (w.__lcGa) loadAnalytics(c); // already loaded this visit: switch storage off
      if (!c.analytics) clearAnalytics();
      // Other tags (e.g. an ads pixel) can listen for this and load only with consent.
      document.dispatchEvent(new CustomEvent('lc:consent', { detail: c }));
    };

    const showBanner = (on: boolean) => {
      root.hidden = !on;
      document.documentElement.classList.toggle('cc-open', on);
    };

    const decide = (c: Omit<Consent, 'v' | 't'>) => {
      apply(write(c));
      showBanner(false);
      if (dialog.open) dialog.close();
    };

    const openSettings = () => {
      const c = read();
      (dialog.querySelector('[name=analytics]') as HTMLInputElement).checked = !!c?.analytics;
      (dialog.querySelector('[name=marketing]') as HTMLInputElement).checked = !!c?.marketing;
      dialog.showModal();
    };

    document.querySelectorAll('[data-cc-accept]').forEach((b) => b.addEventListener('click', () => decide({ analytics: true, marketing: true })));
    document.querySelectorAll('[data-cc-reject]').forEach((b) => b.addEventListener('click', () => decide({ analytics: false, marketing: false })));
    document.querySelector('[data-cc-manage]')?.addEventListener('click', openSettings);
    document.querySelector('[data-cc-save]')?.addEventListener('click', () =>
      decide({
        analytics: (dialog.querySelector('[name=analytics]') as HTMLInputElement).checked,
        marketing: (dialog.querySelector('[name=marketing]') as HTMLInputElement).checked,
      }),
    );
    document.querySelectorAll('[data-cookie-settings]').forEach((b) => b.addEventListener('click', openSettings));

    const existing = read();
    if (existing) apply(existing);
    else showBanner(true);
  }
</script>
